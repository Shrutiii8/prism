# ==============================================================================
# PRISM: Integrated Institution Complaint Monitoring and Coordination Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production
DEBUG=false
APP_NAME="PRISM - Integrated Institution Complaint Monitoring and Coordination Platform"
API_V1_STR=/api/v1

# Security & Cryptography
# Generate a strong 64-character secret using: openssl rand -hex 32
SECRET_KEY=prism-super-secret-enterprise-key-2026-production-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg for async SQLAlchemy)
POSTGRES_USER=prism_admin
POSTGRES_PASSWORD=PrismSecure2026DB!
POSTGRES_DB=prism_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://prism_admin:PrismSecure2026DB!@postgres:5432/prism_db
SYNC_DATABASE_URL=postgresql://prism_admin:PrismSecure2026DB!@postgres:5432/prism_db

# Local SQLite fallback for standalone development (uncomment to use)
# DATABASE_URL=sqlite+aiosqlite:///./prism.db
# SYNC_DATABASE_URL=sqlite:///./prism.db

# In-Memory Cache & Background Task Queue (Redis)
REDIS_URL=redis://redis:6379/0

# Event-Streaming Bus (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Evidence & Document Storage
UPLOAD_DIR=/app/storage/uploads
MAX_FILE_SIZE_BYTES=26214400

# AI Overlap Intelligence Engine Parameters
AI_HIGH_SIMILARITY_THRESHOLD=0.75
AI_MEDIUM_SIMILARITY_THRESHOLD=0.45
WEIGHT_INSTITUTION=0.40
WEIGHT_SEMANTIC=0.35
WEIGHT_CATEGORY=0.15
WEIGHT_CONTEXT=0.10

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

